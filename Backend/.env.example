# Fazm Backend Configuration
PORT=8080

# RSA private key for signing subject tokens (PEM format)
VERTEX_SA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# OIDC issuer (must match the Cloud Run URL)
VERTEX_ISSUER=https://fazm-backend-xxxxx.run.app

# GCP Workload Identity Federation
GCP_PROJECT_NUMBER=your-project-number
GCP_WORKLOAD_POOL=fazm-desktop-pool
GCP_OIDC_PROVIDER=fazm-backend-provider
GCP_SERVICE_ACCOUNT=vertex-ai-sa@your-project.iam.gserviceaccount.com

# Vertex AI
VERTEX_PROJECT_ID=your-project-id
VERTEX_REGION=us-east5

# API keys served to authenticated clients
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=your-deepgram-key
GEMINI_API_KEY=your-gemini-key
FIREBASE_PROJECT_ID=fazm-prod
BUILTIN_KEY_BLOCKLIST=

# Mediar dashboard usage forwarding
MEDIAR_USAGE_INGEST_URL=https://your-mediar-host/api/llm-usage/fazm-report
MEDIAR_USAGE_INGEST_SECRET=shared-secret

# Stripe (subscription billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_INTRO_COUPON_ID=coupon-id
STRIPE_WEBHOOK_SECRET=whsec_...

# Composio (third-party integrations: Gmail, etc.)
# API key is server-only; never shipped to clients. Per-toolkit IDs are created
# by the dashboard at platform.composio.dev and reused across all users.
COMPOSIO_API_KEY=ak_...
COMPOSIO_GMAIL_AUTH_CONFIG_ID=ac_...
COMPOSIO_GMAIL_MCP_SERVER_ID=...
